var updateJarOnline = function (callback, container) {
    FR.ajax({
        url: FR.servletURL + '?op=fs_server&cmd=updateJar',

        complete: function (res, status) {

            if (status === 'success') {
                $(window).unbind('beforeunload');
                var result = FR.jsonDecode(res.responseText);
                if (result.status === 'success') {
                    FR.showNeededDialog(FR.i18nText("FS-Plugin_updateOnline_update"), FR.i18nText("FS-Plugin_updateTo") + container.getWidgetByName('latestjartime').getValue() + ',' + FR.i18nText("FS-Plugin_updateOnline_RestartServer"));
                } else if (result.status === 'jetty') {
                    FR.showNeededDialog(FR.i18nText("FS-Plugin_updateOnline_update"), FR.i18nText("FS-Plugin__NotSupportJetty"));
                } else if (result.status === 'notRestart') {
                    FR.showNeededDialog(FR.i18nText("FS-Plugin_updateOnline_update"), FR.i18nText("FS-Plugin_updateOnline_NoNext"));
                } else {
                    FR.showNeededDialog(FR.i18nText("FS-Plugin_updateOnline_update"), FR.i18nText("FS-Plugin_updateOnline_Error") + FR.i18nText(result.message), FR.i18nText("FR-Basic_OK"), true);
                }
                callback('task succeed');       //不管成功or失败,进度条走完即消失
            }
        }
    });
    var getProgress = function () {
        var self = this;
        FR.ajax({
            url: FR.servletURL + '?op=fs_server&cmd=progress',
            complete: function (res, status) {
                if (status === 'success') {
                    var value = FR.jsonDecode(res.responseText);
                    self.value = value.detail;
                    if (self.value) {
                        callback(self.value);
                    }
                }
            }
        });
    };
    var operation = setInterval(getProgress, 1000);
    if (!FR.isEmpty(this.value) && this.value.detail === "100%") {
        clearInterval(operation);
    }
};

