    var _modifyPosition = function ($view, isRelative, relativeLeft) {
        var btn = FS.SYSMGR.tabPane.getWidgetByName('sms_username');
        var invalid = btn.options.offset != null && btn.element.offset().top === 0 && btn.element.offset().left === 0;
        var eH = Math.max(parseInt(invalid ? btn.options.offset.top : btn.element.offset().top), 0);
        var eL = Math.max(parseInt(invalid ? btn.options.offset.left : btn.element.offset().left), 0);
        var wH = parseInt(btn.options.height);
        var wL = parseInt(btn.options.width);
        var tH = $view.height();
        var tW = $view.width();

        var bottomHeight = document.body.clientHeight - eH - wH;
        /*b:判断的依据应该是editcomp上下部的高度对比*/
        if (eH < bottomHeight || eH < tH) {
            $view.css('top', eH + wH + (FR.Browser.r.gecko ? 1 : 0));
            if (bottomHeight < tH) {
                _modifyTop(eH, $view, tH);
            }
        } else {
            _modifyTop(eH, $view, tH);
        }
        if (isRelative) {
            $view.css('left', relativeLeft);
        } else {
            if (eL + tW > document.body.clientWidth && (eL + wL > tW)) {
                $view.css('left', eL + wL - $view.width());
            } else {
                $view.css('left', eL);
            }
        }
    };

    var _modifyTop = function (eH, $view, tH) {
        $view.css('top', (eH - tH > 0) ? eH - tH : 0);
    };

