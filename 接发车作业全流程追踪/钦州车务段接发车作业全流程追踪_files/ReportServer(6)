(function ($) {
    var onMessage = function (e) {
        var qqLoginResult = FR.jsonDecode(e.data);
        var uid = qqLoginResult.uid;
        var username = qqLoginResult.username;
        var password = qqLoginResult.password;
        if (uid > 0) {
            $('.qq-dialog-close').trigger('click');
            FS.Tools.bbsUcsynLogin(uid, username, password, function (result) {
                $('.sync-log').remove();
                $('body').append('<div class="sync-log">' + result + '</div>');
                popSmsData();
            }, 'qq');
        }
    };
    if (window.addEventListener) {  // all browsers except IE before version 9
        window.addEventListener("message", onMessage, false);
    } else {
        if (window.attachEvent) {   // IE before version 9
            window.attachEvent("onmessage", onMessage);
        }
    }


    var popSmsData = function (config) {
        FS.SYSMGR.isSMSFuncSupport = true;
        var smsAttr = config || FS.Sync.ajax({
            url: FR.servletURL + '?op=fs_sms&cmd=sms_config_get',
            type: 'POST',
            data: {
                serverID: FS.serverID
            }
        });
        var smsButton = FS.SYSMGR.tabPane.getWidgetByName("sms");
        FS.SYSMGR.isSMSFuncSupport = smsAttr.isSMSFuncSupport;
        if (smsAttr.isSMSOpen) {
            FS.SYSMGR.username = smsAttr.username;
            if (smsAttr.username) {
                FS.Tools.tryBBSLogin(function (result) {
                    $('.sync-log').remove();
                    $('body').append('<div class="sync-log">' + result + '</div>');
                });
            }
            smsButton.setValue(smsAttr.isSMSOpen);
            if (FS.SYSMGR.username) {
                FS.SYSMGR.tabPane.getWidgetByName('sms_username').setValue(FS.SYSMGR.username, false);
                FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([2, 3, 4, 5, 6], true);
            } else {
                FS.SYSMGR.tabPane.getWidgetByName('sms_username').setValue(FR.i18nText("FR-Plugin-Store_Not_Login"), false);
                FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([2, 3, 4, 5, 6], false);
            }
            if (smsAttr.status !== 'success') {
                FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([2, 3, 4, 5, 6], false);
                FS.SYSMGR.tabPane.getWidgetByName("smsSetPanel").setRowVisible([2, 3, 4], false);
                _create404Div();
                return;
            }
            $('.fs-connect-error').remove();
            //FS.SYSMGR.setWidgetValue("accountType", smsAttr.accountType);
            FS.SYSMGR.setWidgetValue("remain", smsAttr.testRemain);
            FS.SYSMGR.setWidgetValue("signature", smsAttr.signature);
            FS.SYSMGR.setWidgetValue("balance", smsAttr.balance + FR.i18nText("FS-System-Config_SMS_Yuan"));
            var reChargeText = smsAttr.balance < 10 ? FR.i18nText("FS-System-Config_SMS_Balance_Warning") : FR.i18nText("FS-System-Config_SMS_Recharge");
            FS.SYSMGR.tabPane.getWidgetByName("rechargeLink").setValue(reChargeText);
            FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([2], !FR.isEmpty(FS.SYSMGR.username) && !smsAttr.isSMSApplied);
            FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([3, 4, 5, 6], smsAttr.isSMSApplied);
            FS.SYSMGR.tabPane.getWidgetByName("smsSetPanel").setRowVisible([2, 3, 4], smsAttr.isSMSApplied && !FR.isEmpty(FS.SYSMGR.username));
            FS.SYSMGR.tabPane.getWidgetByName("smsSettingTablePane").setRowVisible([7], smsAttr.testRemain === 0);
            FS.SYSMGR.tabPane.getWidgetByName("remain").setVisible(smsAttr.testRemain !== 0);
            FS.SYSMGR.tabPane.getWidgetByName("remain-tip").setVisible(smsAttr.testRemain !== 0);

            // var publicGrid = FS.SYSMGR.tabPane.getWidgetByName("publicModel");
            // var privateGrid = FS.SYSMGR.tabPane.getWidgetByName("privateModel");
            // publicGrid.refresh(smsAttr.publicModel);
            // privateGrid.refresh(smsAttr.privateModel);
        } else {
            smsButton.setValue(smsAttr.isSMSOpen, true);
        }
    };
