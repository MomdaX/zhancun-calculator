var createBackupHeaderControl = function (backupDelete) {
    var self = this;
    var header = [
        {
            type: 'iconbutton',
            text: FR.i18nText("FS-System-Config_Delete_Backup"),
            baseClass: 'fs-plugin-update-delete',
            widgetName: backupDelete,
            handler: function () {
                var self = this;
                FR.Msg.confirm(FR.i18nText("FR-Designer_Tooltips"), FR.i18nText("FS-Plugin_confirm_delete"), function (result) {
                    if (result) {
                        var backupGrid;
                        backupGrid = self.getWidgetByName("jarlbackupgrid");
                        if (!backupGrid) {
                            return;
                        }
                        var selectedData = backupGrid.getSelectedData();
                        var backupNames = [];
                        for (var i = 0, len = selectedData.length; i < len; i++) {
                            if (selectedData[i].zipname) {
                                backupNames.push(selectedData[i].zipname);
                            }else {
                                backupNames.push(selectedData[i].jarbackupname);
                            }
                        }

                        var config = {
                            url: FR.servletURL + "?op=fs_server&cmd=deleteJar",
                            data: {
                                backupname: backupNames
                            },
                            type: 'POST'
                        };
                        var completeFn = function (res, status) {
                            if (status === "success") {
                                backupGrid.refresh();
                                FR.showNeededDialog(FR.i18nText("FR-Designer_Tooltips"), FR.i18nText("FS-Plugin_updateOnline_Deleted_Successful"), FR.i18nText("FR-Basic_OK"));
                            } else {
                                backupGrid.refresh();
                                FR.showNeededDialog(FR.i18nText("FR-Designer_Tooltips"), FR.i18nText("FS-Plugin_updateOnline_Deleted_Failed"), FR.i18nText("FR-Basic_OK"));
                            }
                        };
                        if (backupNames.length > 0) {
                            FS.Async.ajax(config, completeFn);
                        } else {
                            FR.showNeededDialog(FR.i18nText("FR-Designer_Tooltips"), FR.i18nText("FS-Plugin_updateOnline_ChooseVersion"), FR.i18nText("FR-Basic_OK"), true);
                        }
                    }
                });
            }
        }, {}
    ];


    return header;
};

var popData = function (index, tabPane) {
    this.tabPane = tabPane;
    _popJartimeUpdata(tabPane);
};
var getJartime = function () {
    return FS.Sync.ajax({
        url: FR.servletURL + "?op=fs_server&cmd=getjartime",
        type: 'POST'
    });
};

var _popJartimeUpdata = function (tabPane) {
    var self = this;
    FR.ajax({
        url: FR.servletURL + "?op=fs_server&cmd=getjartime",
        complete: function (res) {
            var result = FR.jsonDecode(res.responseText);
            var latestJar = tabPane.getWidgetByName('latestjartime');
            var currentJar = tabPane.getWidgetByName('currentjartime');
            var fineVersion = tabPane.getWidgetByName('fineversion');
            var latestVersion = tabPane.getWidgetByName('latestversion');
            var updateButton = tabPane.getWidgetByName('updateconfig');
            var jarTime = getJartime();
            fineVersion.setValue(jarTime.releaseversion);
            if (result.status === 'success') {
                latestJar.setValue(jarTime.latestjartime);
                currentJar.setValue(jarTime.currentjartime);
                if (latestJar.getValue() === currentJar.getValue()) {
                    latestVersion.setValue("   " + FR.i18nText("FS-Plugin_updateOnline_AlreadyLatestVersion"));
                }
            } else {
                latestJar.setValue(FR.i18nText("FS-Plugin_updateOnline_ConnectFailed"));
                currentJar.setValue(jarTime.currentjartime);
                updateButton.setVisible(true);
            }
        }
    });

};


