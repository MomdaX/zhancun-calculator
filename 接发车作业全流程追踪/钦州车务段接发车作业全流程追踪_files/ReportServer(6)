;(function() {
    $.extend(FR, {
        //定制一个简单的对话框,基于FR.Dialog
        showNeededDialog : function (title, arguments, buttontitle, alert) {
            var content;
            var identity;
            if (typeof arguments === 'string') {
                content = arguments;
            }
            if (alert === true) {
                identity = $('<div id="popup_content">'+content+'</div>').css({'left': 30, 'right':30, 'top': 10, 'text-align':'center','font-size': '14px'})
            } else {
                identity = $('<div >'+content+'</div>').css({'left': 30, 'right':30, 'top': 20, 'text-align':'center','font-size': '14px'})

            }
            var dlg = new FR.Dialog({
                title : FR.i18nText(title),
                height : 155,
                width: 280,
                widgetName: 'customdialog',
                contentWidget: {
                    type: 'absolute',
                    items: [
                        {
                            el: identity
                        },
                        {
                            type: 'quickbutton',
                            text: buttontitle == null? FR.i18nText("FS-Button_OK"):buttontitle ,
                            width: 60,
                            height: 30,
                            x: 110,
                            y: 80,
                            handler: function () {
                                //关闭dialog窗口
                                dlg.getWidgetByName('customdialog').doClose();
                            }
                        }
                    ]
                }
            });
            dlg.setVisible(true);
            return dlg;
        }
    })
})();
