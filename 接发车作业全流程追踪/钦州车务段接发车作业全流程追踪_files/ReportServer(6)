            $(opts.renderTag(item)).appendTo($tag);
        } else {
            $tag = $('<span/>').addClass("fs-tagpane-seltag").attr('key', item.key);
            $('<span/>').text(item.value).appendTo($tag);
        }
        if (typeof opts.tagClick === 'function') {
