    <script src="./js/jQuery.print.min.js"></script>
    <script src="./js/jlPrintAndExport.js"></script>
    <script>

        var map_version    = "C260702";
        var map_width      = 1521;
        var map_height     = 932;
        var lj_color_list  = ["#000000","#ef4136","#00FF00","#ef4136","#22CEFF","#f47920","#00FF00","#22CEFF","#ef4136","#22CEFF","#ef4136","#00FF00","#ef4136","#22CEFF","#00FF00","#ef4136","#22CEFF","#00FF00","#ef4136"];

        //设置MapVeriosn
       /* $(".right_svg_version").append(map_version);*/
        $(".right_version").append(map_version);

        var map;                //地图对象
        var search;             //检索对象
        var jl;                 //点到点径路
        var jlRing;             //环状径路
        var jlScope;            //径路范围对象
        var jlprintexport;      //定义打印和导出

        $(document).ready(function(){

            //屏蔽右键菜单
            $(document).bind("contextmenu", function(e){
                return false;
            });

            // 调整页面大小
            $(window).resize(function()
            {
                //设置DIV_SVG宽度（无左侧菜单，占满窗口）
                var right_svg_width = $(window).width();
                $(".right_svg").width(right_svg_width);

                //设置DIV_SVG高度
                var right_svg_height = $(window).height() - $(".top").height();
                $(".right_svg").height(right_svg_height);

                //设置SVG高度
                $("svg").width(right_svg_width);

                //设置SVG高度
                $("svg").height(right_svg_height - $(".right_svg_version").height() - $(".right_svg_prompt").height());

                //设置Jl_INPUT
                /*var jl_width = parseInt( $(".right_svg_jl").width());
                $(".right_svg_jl").css("margin-left", right_svg_width - jl_width);*/
            });

            //设置DIV_SVG宽度
            var right_svg_width = $(".right_svg").width();

            //设置DIV_SVG高度
            var right_svg_height = $(".right_svg").height();

            //设置SVG高度
            $("svg").width(right_svg_width);

            //设置SVG高度
            $("svg").height(right_svg_height - $(".right_svg_version").height() - $(".right_svg_prompt").height());

            //打开地图
            map = new Map($("svg").height(), $("svg").width());
            map.createMap();

            //数据检索
            search = new Search();

            //点到点径路
            jl = new Jl();

            //环状径路
            jlRing = new JlRing();

            //径路范围
            jlScope = new JlScope();

            //打印和导出
            jlprintexport = new jlPrintAndExport();

            $(".icon-tupian").click(function () {
                jlprintexport.jlExport();
            });
            $(".icon-dayin").click(function () {
                jlprintexport.jlPrint();
            });


            $(".btn-group span").mouseover(function(){
                $(this).css({"background-color":"#505050"},500);
            }).mouseout(function () {
                $(this).css({"background-color":"#3c3f41"},500);
            });
            $(".btn-group span").mousedown(function(){
                $(this).css("color","#4A4A4A");
            }).mouseup(function () {
                $(this).css({"color":"white"},500);
            })

        });

        //监测键盘Ctrl+Z
        $(document).on("keypress", function(e){
            if (e.ctrlKey && e.which == 26)         //ctrl + z
            {
                //点点回退
                if (jl.getJlState() == 1)
                {
                    //执行回退
                    jl.undoJl();
                    return;
                }

                //环状回退
                if (jlRing.getJlState() == 3)
                {
                    //执行回退
                    jlRing.undoJlRing();
                    return;
                }

                //支点径路回退
                if (jlScope.getJlScopeState() != "")
                {
                    //执行回退
                    jlScope.undoJlScope();

                }
            }
        });


    </script>


<div class="right_svg_version">
    <div id="left_toolbar" role="toolbar" aria-label="Toolbar with button groups" class="Left_toolbar"><div class="btn-group" role="group" aria-label="First group"><span style="height: 26px;width: 26px" class="iconfont icon-wangluo1 toolbar_icon" onclick="eval(map.getMapColor(1))" title="路局显示"></span><span style="height: 26px;width: 26px" class="iconfont icon-jiedian3 toolbar_icon" onclick="eval(map.setMidStationShowModel())" title="中间站显示"></span><span style="height: 26px;width: 26px" class="iconfont icon-xiansuoguanxitu toolbar_icon" onclick="eval(search.findMapInfo())" title="查看路网数据"></span><span style="height: 26px;width: 26px" class="iconfont icon-dingwei toolbar_icon" onclick="eval(search.findStation())" title="车站检索"></span><span style="height: 26px;width: 26px" class="iconfont icon-xian toolbar_icon" onclick="eval(jl.pointPointJl())" title="点点径路"></span><span style="height: 26px;width: 26px" class="iconfont icon-huanxingbuju toolbar_icon" onclick="eval(jlRing.start())" title="环状径路"></span><span style="height: 26px;width: 26px" class="iconfont icon-chu1 toolbar_icon" onclick="eval(jlScope.getJlScope(1))" title="支点径路(到域)"></span><span style="height: 26px;width: 26px" class="iconfont icon-chu toolbar_icon" onclick="eval(jlScope.getJlScope(2))" title="支点径路(发域)"></span><span style="height: 26px;width: 26px" class="iconfont icon-xiaolajiao toolbar_icon" onclick="eval(jl.getNostalgicJl())" title="怀旧径路"></span></div></div>
    <div id="Sleft_toolbar" role="toolbar" aria-label="Toolbar with button groups" class="SLeft_toolbar">
        <div class="btn-group" role="group" aria-label="Second group">
