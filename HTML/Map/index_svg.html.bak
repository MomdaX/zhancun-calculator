<script>
    var cx1 = document.querySelector("#cx1");
    var yc1 = document.querySelector("#yc1")
    cx1.onmousemove= function () {
        yc1.style.display = "inline-block"
    }
    cx1.onmouseout= function () {
        yc1.style.display = "none"
    }

    row = document.createElement("tr");
    td1 = document.createElement("td");
    td2 = document.createElement("td");
    td3 = document.createElement("td");

    $.ajax
    ({
        type : "GET",
        url : "/getReleaseVersionData",
        data : {},
        beforeSend: function(request) {
            request.setRequestHeader("Authorization", window.sessionStorage.token);
        },
        success : function(msg)
        {
            td1.appendChild(document.createTextNode(msg[0]));
            td2.appendChild(document.createTextNode(msg[1]));
            td3.appendChild(document.createTextNode(msg[2]));
        },
        error : function(errorMsg)
        {
            map.setMsgInfo(errorMsg + ' -> getReleaseVersionData()失败');
        }
    });

    // td1.appendChild(document.createTextNode("C230902"));
    // td2.appendChild(document.createTextNode("2023-09-08"));
    // td3.appendChild(document.createTextNode("1.根据铁货电[2023]72号，新增沙狮联络线；2.根据货价电〔2023〕69号，广州西线、走马营站全项取消；3.根据铁运函〔2023〕243号，浦江站更名为郑家坞站；4.根据铁运函〔2023〕62号，鄱阳站更名为鄱阳北站，南昌南更名为青云谱站，横岗站更名为南昌南站，上杭站更名为蛟洋站。"));
    td3.style.textAlign = "left";
    row.appendChild(td1);
    row.appendChild(td2);
    row.appendChild(td3);
    document.getElementById("rows1").append(row);
</script>
<style>
    #map_table{
        width:100%;
        height:100%;
        border-collapse: collapse;
        table-layout:fixed;
        background-color: white;
        border: 1px solid lightgrey;
        text-align: center;
    }
    #rows1 tr{
        width: calc(100%);
    }
    .map_th{
        border: 1px solid #708090;
        text-align: center;
        font-size: 12px;
        height: 30px;
    }
    #rows1 td{
        border: 1px solid #708090;
        font-size: 15px;
        text-align: center;
    }
</style>
</div>
        </div>
    </div>
    <div class="addparent-modal-panel">


    
    <link href="./css/nostalgic.css" rel="stylesheet">
    <script src="./js/nostalgic.js"></script>

<div class="modal fade bs-example-modal-sm" style="height: 610px; width: 975px; margin-left: 450px; margin-top: 150px; display: none; left: 94px; top: 37px;" data-backdrop="false" id="NostalgicJlModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
<!--    <div class="modal-dialog">-->
        <div class="modal-content" style="height: 600px; width: 965px; background-color: #FFFFFF">
            <div class="modal-header" style="height: 40px;">
                <h5 class="modal-title" id="myModalLabel" style="font-weight: 600;">怀旧径路</h5>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>

            <div class="modal-body" id="main">
                <!--    左部分-->
                <div id="leftBar">
                    <!--        发/到站位置-->
                    <div class="box1 bgColor">
                        <span class="title title1">发站</span>
                            <input autocomplete="off" autofocus="" id="fz_input" name="station_input" type="text" class="input1" maxlength="30">
                        <ul id="uli" class="ul_li_out" style="border: 1px solid rgb(255, 255, 255); margin-top: 5px; display: none;"></ul>
                    </div>

                    <div class="box1 bgColor">
                        <span class="title title1">到站</span>
                            <input autocomplete="off" id="dz_input" name="station_input" type="text" class="input1" maxlength="30">
                    </div>

                    <!--        经由站设置-->
                    <div class="box2 bgColor">
                        <span class="title title2">经由站</span>
<!--                        <form input="return addTable()">-->
                            <input autocomplete="off" id="mid_input" name="station_input" type="text" class="input1" maxlength="30">
<!--                        </form>-->

                        <div class="box7">

                            <table id="hj_table" class="table table-bordered table-condensed">
                                <thead>
                                <tr>
                                    <th style="border: 1px solid #708090;box-shadow: 1px 1px 3px #708090; text-align: center;font-weight: normal;font-size: 12px" width="30">电报码</th>
                                    <th style="border: 1px solid #708090;box-shadow: 1px 1px 3px #708090; text-align: center;font-weight: normal;font-size: 12px" width="30">站名</th>
                                    <th style="border: 1px solid #708090;box-shadow: 1px 1px 3px #708090; text-align: center;font-weight: normal;font-size: 12px" width="30">路局</th>
                                </tr>
                                </thead>
                                    <tbody id="id_tbody" style="font-size: 12px"></tbody>
                            </table>

                        </div>

                        <button id="movUp" class="button1 btn btn-primary btn-sm">
                            <span>∧</span>
                        </button>
                        <!--∧∨↑↓⩔⩓-->
                        <button id="movDown" class="button1 btn btn-primary btn-sm">
                            <span>∨</span>
                        </button>
                        <button id="del_btn" class="button1 btn btn-primary btn-sm">
                            <span>✕</span>
                        </button>
                    </div>
                </div>
                <!--    右部分-->
                <div id="rightBar">
                    <div class="box8 bgColor">
                        <span class="title title1">品类</span>
                        <select id="pm_select" class="itemSelect1" onchange="$(&#39;#jljs&#39;).focus();"><option value="0">==请选择==</option></select>
                    </div>
                    <div class="box9 bgColor">
                        <span class="title title2">记事标</span>
                        <select id="jsb_select" class="itemSelect2" onchange="$(&#39;#jljs&#39;).focus();"><option value="0">==请选择==</option></select>
                    </div>
                    <!--        运输特征-->
                    <div class="box3 bgColor">
                        <span class="title title3">运输特征</span>
                        <label style="margin-left: 10px;font-weight: normal"><input type="radio" name="1" id="zc_radio" class="input3" checked="" value="1">特定</label>
                        <label style="margin-left: 10px;font-weight: normal"><input type="radio" name="1" id="zd_radio" value="2">最短</label>

                    </div>
                    <!--        输入方式-->
                    <div class="box4 bgColor">
                        <span class="title title3">输入方式</span>
                        <label style="margin-left: 7px;font-weight: normal;"><input type="radio" name="optradios" id="station_sm_radio" value="1" checked="" class="input3">声母</label>
                        <label style="margin-left: 7px;font-weight: normal"><input type="radio" name="optradios" id="station_dbm_radio" value="2">略号</label>
                        <label style="margin-left: 7px;font-weight: normal"><input type="radio" name="optradios" id="station_hz_radio" value="3">汉字</label>
                    </div>
                    <!--        按钮-->
                    <div class="box5">
                        <button type="button" id="jljs" class="button2 jljs_btn btn btn-primary btn-sm"><p>径路计算</p></button>
                        <button type="button" id="cleanAll" onclick="cleanAllBtn()" class="button2 qk_btn btn btn-success btn-sm"><p><img src="./images/clear_white.png" class="clean_img">清空</p></button>
                    </div>
                    <!--        TextArea-->
                    <div class="box6">
                        <pre style="background: #FFF8DC;border: 1px solid #FFF8DC;" id="tArea" disabled="disabled"></pre>
                    </div>
                </div>
            </div>
        </div>
<!--    </div>-->
</div>

<script>
    $(document).ready(function(){
        //输入框获得焦点
        $("#fz_input").focus();

        var mark = document.querySelector('#NostalgicJlModal');
        var title = document.querySelector('.modal-content');
        title.addEventListener('mousedown',function (e) {
            var x = e.pageX-mark.offsetLeft;
            var y = e.pageY-mark.offsetTop;
            document.addEventListener('mousemove',move);
            function move(e) {
                mark.style.left= e.pageX - x - 450 + 'px';
                mark.style.top= e.pageY - y - 150 + 'px';
            }
            document.addEventListener('mouseup',function (e) {
                document.removeEventListener('mousemove',move)
            })
        })
    });
</script></div>

<div class="layui-layer-move"></div></body></html>
